# ============================================================================
# Unified Social Media MCP Server — Environment Variables
# Copy this to .env and fill in the values for your setup.
# Only configure the providers you plan to use.
# ============================================================================

# -- Platforms ---------------------------------------------------------------
# Comma-separated list of platforms to enable
ENABLED_PLATFORMS=twitter,bluesky,linkedin,facebook

# Twitter / X
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Bluesky
BLUESKY_IDENTIFIER=your-handle.bsky.social
BLUESKY_PASSWORD=your-app-password

# LinkedIn
LINKEDIN_ACCESS_TOKEN=

# Facebook / Meta
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=

# -- Media (Cloudinary) -----------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -- Stock Images (Unsplash, optional) --------------------------------------
UNSPLASH_ACCESS_KEY=

# -- Link Management (Dub.co) -----------------------------------------------
DUB_API_KEY=

# -- Brand Monitoring (Social Searcher, optional) ----------------------------
SOCIAL_SEARCHER_API_KEY=

# -- Database ----------------------------------------------------------------
# Override the default SQLite path (~/.social-mcp/data.db)
# SOCIAL_MCP_DB_PATH=/custom/path/data.db
