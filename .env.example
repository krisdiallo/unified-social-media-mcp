# ============================================================================
# Unified Social Media MCP Server — Environment Variables
# Copy this to .env and fill in the values for your setup.
# ============================================================================

# -- Content Generation ------------------------------------------------------
# Options: "openai" | "ollama"
CONTENT_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# -- Platforms ---------------------------------------------------------------
# Comma-separated list of platforms to enable
ENABLED_PLATFORMS=twitter,bluesky,linkedin,facebook

# Twitter / X
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Bluesky
BLUESKY_IDENTIFIER=your-handle.bsky.social
BLUESKY_PASSWORD=your-app-password

# LinkedIn
LINKEDIN_ACCESS_TOKEN=

# Facebook / Meta
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=

# -- Media -------------------------------------------------------------------
UNSPLASH_ACCESS_KEY=
